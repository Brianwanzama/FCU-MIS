# Copy this file to .env and fill in real values. Never commit the real .env file.
# On Railway, set these as service variables instead (see docs/DEPLOYMENT.md).

# --- Core Django ---
# Production uses config.settings.prod (HTTPS only, secure cookies, manifest static files).
# DJANGO_SETTINGS_MODULE=config.settings.prod   (set this one on the server, not here)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: extra hosts / origins, e.g. a custom domain
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (PostgreSQL) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:change-me@localhost:5432/fcu_mis

# --- Email (account activation notices, password reset) ---
# For local dev, leave EMAIL_BACKEND as the console backend so emails print to the terminal.
# In production use SMTP, otherwise members cannot receive password-reset emails.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.org

# --- File storage (point both at a persistent volume in production) ---
FCU_MEDIA_ROOT=
FCU_PRIVATE_MEDIA_ROOT=
FCU_UPLOAD_MAX_MB=5

# --- FCU business defaults (fallbacks only) ---
FCU_DEFAULT_MONTHLY_SAVINGS=100000
FCU_DEFAULT_MONTHLY_EMERGENCY=5000
FCU_DEFAULT_LOAN_INTEREST_PERCENT=5.0
FCU_LOAN_LIMIT_PERCENT=100.0

# --- Automatic loan recovery (Manual 4.6): True = overdue loans are recovered from savings ---
FCU_LOAN_AUTO_RECOVERY_ENABLED=True
FCU_LOAN_RECOVERY_POLICY_REF=FCU Manual v3.0, section 4.6
